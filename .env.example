# ========================================================
# Konfigurasi Backend Node.js
# ========================================================
PORT=3000
NODE_ENV=development

# Rahasia untuk validasi signature token anti-IDOR
SECURITY_SECRET=your_super_secret_hmac_key_here
REQUIRE_TOKEN_AUTH=false

# ========================================================
# Konfigurasi Perhitungan Pajak Coretax
# ========================================================
# Opsi: CORETAX_OFFICIAL (sesuai template resmi DJP) atau PROMPT_CUSTOM (spesifikasi awal)
TAX_STRATEGY=CORETAX_OFFICIAL
DEFAULT_VAT_RATE=12
DEFAULT_TRX_CODE=04

# ========================================================
# Konfigurasi Odoo 19 Online External API
# ========================================================
ODOO_URL=https://mycompany.odoo.com
ODOO_DB=mycompany_db
ODOO_USERNAME=admin@mycompany.com
ODOO_API_KEY=your_odoo_user_api_key_here

# Nama atau ID Perusahaan ISE
ODOO_COMPANY_NAME=ISE
ODOO_COMPANY_ID=1
ODOO_TIMEOUT_MS=15000

